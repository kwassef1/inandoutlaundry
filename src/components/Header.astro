---
import logo from "../assets/inout.svg";
---

<header id="header">
    <div class="container">
        <div class="logo">
            <img src={logo.src} alt="In & Out Laundry Logo" class="iol-logo" />
            <a href="/">In & Out Laundry</a>
        </div>

        <nav class="nav">
            <ul>
                <li><a href="#product-grid-section">Services</a></li>
                <li><a href="#hours-section">Hours</a></li>
                <li><a href="#footer">Contact</a></li>
            </ul>
        </nav>
    </div>
</header>

<style>
    /* Header Styles */
    #header {
        background-color: var(--iol-white);
        padding: 1.2rem 0.8rem 1.2rem;
        position: sticky;
        overflow: hidden;
        top: 0;
        z-index: 1000;
    }

    .container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 1.2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    /* Logo Styles */
    .logo {
        display: flex;
        align-items: center;
        gap: 0.8rem;
    }

    .logo img {
        height: 32px;
    }
    .logo a {
        font-size: 1.7rem;
        font-weight: 800;
        font-family: var(--iol-font);
        color: var(--iol-navy);
        text-decoration: none;
        letter-spacing: -0.5px;
    }

    /* Navigation Styles */
    .nav ul {
        list-style: none;
        display: flex;
        gap: 2rem;
        margin: 0;
        padding: 0;
    }

    .nav a {
        font-family: var(--iol-font);
        font-weight: 600;
        color: var(--iol-navy);
        text-decoration: none;
        transition: 0.3s ease;
    }

    .nav a:hover {
        color: var(--iol-medium-blue);
    }

    @media (max-width: 968px) {
        #header {
            padding: 1rem 0.6rem;
        }
        .container {
            padding: 0 1rem;
            gap: 0.8rem;
        }
        .logo img {
            height: 28px;
        }
        .logo a {
            font-size: 1.5rem;
        }
        .nav ul {
            gap: 1.5rem;
        }
        .nav a {
            font-size: 0.95rem;
        }
    }

    /* Mobile Landscape */
    @media (max-width: 800px) {
        #header {
            padding: 1rem 0.5rem;
        }
        .container {
            flex-direction: column;
            gap: 1rem;
            padding: 0 0.8rem;
        }
        .logo {
            gap: 0.6rem;
        }
        .logo img {
            height: 26px;
        }
        .logo a {
            font-size: 1.4rem;
        }
        .nav ul {
            gap: 1rem;
            flex-wrap: wrap;
            justify-content: center;
        }
        .nav a {
            font-size: 0.9rem;
        }
    }

    /* Mobile Portrait */
    @media (max-width: 480px) {
        .header {
            padding: 0.8rem 0.4rem;
        }
        .container {
            gap: 0.8rem;
            padding: 0 0.6rem;
        }
        .logo {
            gap: 0.5rem;
        }
        .logo img {
            height: 24px;
        }
        .logo a {
            font-size: 1.3rem;
            letter-spacing: -0.3px;
        }
        .nav ul {
            gap: 0.8rem;
        }
        .nav a {
            font-size: 0.85rem;
            padding: 0.3rem 0.5rem;
        }
    }

    /* Extra Small Screens */
    @media (max-width: 360px) {
        .header {
            padding: 0.6rem 0.3rem;
        }
        .container {
            gap: 0.6rem;
            padding: 0 0.4rem;
        }
        .logo img {
            height: 22px;
        }
        .logo a {
            font-size: 1.2rem;
        }
        .nav ul {
            gap: 0.5rem;
        }
        .nav a {
            font-size: 0.8rem;
            padding: 0.2rem 0.4rem;
        }
    }
</style>
