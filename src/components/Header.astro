---
import logo from '../assets/inout.svg';
---
<header class="header">
  <div class="container">
    <div class="logo">
        <img src={logo.src} alt="In & Out Laundry Logo" class="iol-logo" />
        <a href="/">In & Out Laundry</a>
    </div>

    <nav class="nav">
      <ul>
        <li><a href="/services">Services</a></li>
        <li><a href="/about">Hours</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>

/* Header Styles */
  .header {
    background-color: var(--iol-sky);
    padding: 1.2rem 0.8rem 1.2rem;
    position: relative;
    overflow: hidden;
    
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  /* Logo Styles */
    .logo {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .logo img {
    height: 32px;
  }
  .logo a {
    font-size: 1.7rem;
    font-weight: 800;
    font-family: var(--iol-font);
    color: var(--iol-navy);
    text-decoration: none;
    letter-spacing: -0.5px;
  }

/* Navigation Styles */
  .nav ul {
    list-style: none;
    display: flex;
    gap: 2rem;
    margin: 0;
    padding: 0;
  }

  .nav a {
    font-family: var(--iol-font);
    font-weight: 600;
    color: var(--iol-navy);
    text-decoration: none;
    transition: 0.3s ease;
  }

  .nav a:hover {
    color: var(--iol-white);
  }

  @media (max-width: 800px) {
    .container {
      flex-direction: column;
      gap: 1rem;
    }

    .nav ul {
      gap: 1rem;
    }
  }

  @media (max-width: 480px) {
    .logo a {
      font-size: 1.4rem;
    }
  }
</style>
