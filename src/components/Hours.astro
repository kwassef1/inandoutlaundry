---
const { 
  title = "Hours & Location",
  address = "264 Broadway, Newark, NJ 07104\n(Entrance on side street)",
  hours = [
    { days: "Everyday", time: "7:00 AM – 9:00 PM" },
    { days: "Last Wash", time: "8:30 PM" }
  ]
} = Astro.props;
---

<section class="hours-section">
  <div class="container">
    <h2 class="section-title">{title}</h2>

    <div class="hours-grid">
      <div class="hours-block">
        <h3 class="small-heading">Hours</h3>

        <ul class="hours-list">
          {hours.map((item: { days: string; time: string }) => (
            <li>
              <span class="days">{item.days}</span>
              <span class="time">{item.time}</span>
            </li>
          ))}
        </ul>
      </div>
      
      <div class="location-block">
        <h3 class="small-heading">Location</h3>
        <p class="address">{address}</p>
      </div>

      
    </div>
  </div>
</section>

<style>
  .hours-section {
    padding: 4rem 0;
    background: var(--iol-sky);
  }

  .section-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--iol-navy);
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .hours-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12rem;
  }

  .small-heading {
    font-size: 1rem;
    font-weight: 700;
    color: var(--iol-navy);
    text-transform: uppercase;
    margin-bottom: 0.6rem;
    letter-spacing: 0.06em;
  }

  .address {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.6;
    color: #3a3a3a;
  }

  .hours-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .hours-list li {
    display: flex;
    justify-content: space-between;
    padding: 0.6rem 0;
    border-bottom: 1px solid rgba(0,0,0,0.1);
    font-size: 1.1rem;
    color: #3a3a3a;
  }

  .hours-list li:last-child {
    border-bottom: none;
  }

  .days {
    font-weight: 500;
  }

  .time {
    font-weight: 600;
    color: var(--iol-navy);
  }

  @media (max-width: 768px) {
    .hours-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .section-title {
      font-size: 1.75rem;
    }
  }
</style>
