---
import hero from '../assets/hero_image.webp';
import background from '../assets/background.svg';
---

<div class="hero-page">
	<main class="main-content">
		<section class="hero">
			<div class="hero-content">
				<h1>Welcome to <pre>In & Out Laundry</pre></h1>
				<p>Your modern laundromat in Newark, NJ</p>
			</div>
			<img src={hero.src} alt="In & Out Laundry Laundromat Interior" width="1400px"/>
			
		</section>
	</main>
</div>

<style>
	.hero-page {
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	.main-content {
		flex: 1;
		display: flex;
		justify-content: center;
		padding: 2rem;
	}

	.hero {
		width: 100%;
		position: relative;
		overflow: hidden;
		max-width: 1400px;
		border-radius: 16px;
		overflow: hidden;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
		text-align: left;
		text-align: flex-start;


		height: stretch;
		display: flex;
		flex-direction: row;
		align-items: flex-start;
	}


	.hero-img {
		position: absolute;
		align-items: flex-end;
		inset: 0;
		width: 100%;
		height: auto;
		object-fit: cover;
	}

	.hero-content {
		padding: 2rem;
		padding-bottom: 0rem;
		border-radius: 12px;
	}

	h1 {
		font-size: 50px;
		margin-top: 0.25em;
	}

	pre {
		font-family:
			ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono',
			monospace;
		font-weight: normal;
		background: linear-gradient(14deg, #33b4d8 0%, #415eff 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		margin: 0;
	}

	h2 {
		margin: 0 0 1em;
		font-weight: normal;
		color: #111827;
		font-size: 20px;
	}

	p {
		color: #4b5563;
		font-size: 16px;
		line-height: 24px;
		letter-spacing: -0.006em;
		margin: 0;
	}

	@media screen and (max-width: 768px) {
		.hero-content {
			padding: 1.5rem 1rem;
		}

		h1 {
			font-size: 24px;
			line-height: 1.3;
		}
	}
</style>
