---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import ProductGrid from "../components/ProductGrid.astro";
import Hours from "../components/Hours.astro";

const services = [
    {
        image: "https://images.unsplash.com/photo-1517677208171-0bc6725a3e60?w=500&h=500&fit=crop",
        title: "Self Serve Laundry",
        description: "Modern machines available for your convenience",
    },
    {
        image: "https://images.unsplash.com/photo-1582735689369-4fe89db7114c?w=500&h=500&fit=crop",
        title: "Wash & Fold",
        description: "Drop off your laundry and pick it up clean and folded",
    },
    {
        image: "https://images.unsplash.com/photo-1556911220-bff31c812dba?w=500&h=500&fit=crop",
        title: "Home Delivery",
        description: "We clean, and deliver right to your door",
    },
];
---

<Layout>
    <Header />
    <Hero />
    <ProductGrid title="Our Services" products={services} />
    <Hours />
    <Footer />
</Layout>
